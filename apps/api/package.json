{
  "name": "@repairproof/api",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20.19.0" },
  "scripts": {
    "prebuild": "pnpm --filter @repairproof/shared build",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "predev": "pnpm --filter @repairproof/shared build",
    "dev": "nest start --watch",
    "prestart": "pnpm --filter @repairproof/shared build",
    "start": "nest start",
    "prestart:dev": "pnpm --filter @repairproof/shared build",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretest": "pnpm --filter @repairproof/shared build",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "pretest:integration": "pnpm --filter @repairproof/shared build",
    "test:integration": "jest --runInBand test/repair-case.integration.spec.ts test/repair-case.api.integration.spec.ts",
    "pretypecheck": "pnpm --filter @repairproof/shared build",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "db:seed": "ts-node src/prisma/seed.ts",
    "platform-admin:manage": "ts-node src/prisma/platform-admin.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.6.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.3.0",
    "@prisma/client": "^7.10.1",
    "@repairproof/shared": "workspace:*",
    "@sentry/nestjs": "^11.17.0",
    "@supabase/supabase-js": "^2.119.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "multer": "^2.5.0",
    "nanoid": "^6.0.2",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^12.0.15",
    "@nestjs/schematics": "^12.0.16",
    "@nestjs/testing": "^12.6.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.7",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prisma": "^7.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript-eslint": "^8.74.0",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2"
  }
}
