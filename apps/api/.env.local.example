# Local API database only. Copy this file to apps/api/.env and replace the
# password with the one you set in the local PostgreSQL installer.
# Do not put a Supabase/production connection string in this file.
DATABASE_URL=postgresql://postgres:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:5432/repairproof_dev?schema=public
DIRECT_URL=postgresql://postgres:CHANGE_ME_LOCAL_PASSWORD@127.0.0.1:5432/repairproof_dev?schema=public

# First-party RepairProof password authentication. Generate a unique random
# value of at least 32 bytes for this local environment.
AUTH_JWT_SECRET=replace-with-at-least-64-hex-characters

# Supabase remains optional for private evidence storage only.
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=4
RATE_LIMIT_KEY_PREFIX=repairproof:rate-limit
API_PORT=3001
API_CORS_ORIGIN=http://localhost:5173
API_TRUST_PROXY_HOPS=0
PUBLIC_APP_URL=http://localhost:5173
EVIDENCE_STORAGE_DISABLED=true
DIAGNOSTIC_LLM_ENABLED=false
