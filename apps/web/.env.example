VITE_API_URL=/api
# Set the actual HTTPS public origin in the production build environment. Placeholder hosts disable indexing.
VITE_APP_URL=
# For local Vite development, the dev server proxies /api to this target.
API_PROXY_TARGET=http://localhost:3001
# Opt in to clearly labeled fictional consumer and technician fixtures in dev only.
VITE_ENABLE_DEMO_FIXTURES=false
