FROM node:22-alpine AS build

WORKDIR /app
RUN npm install --global pnpm@10.19.0

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY packages/shared ./packages/shared
COPY apps/api ./apps/api

RUN pnpm install --frozen-lockfile \
    && pnpm --filter @repairproof/api db:generate \
    && pnpm --filter @repairproof/api build \
    && generated_client="$(find /app/node_modules/.pnpm -path '*/node_modules/.prisma/client/index.js' -print -quit)" \
    && test -n "$generated_client" \
    && cp -R "$(dirname "$generated_client")" /app/.prisma-client

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
RUN npm install --global pnpm@10.19.0 \
    && addgroup -S repairproof \
    && adduser -S -G repairproof repairproof

COPY --from=build /app/package.json /app/pnpm-workspace.yaml /app/pnpm-lock.yaml ./
COPY --from=build /app/packages/shared/package.json ./packages/shared/
COPY --from=build /app/packages/shared/src ./packages/shared/src
COPY --from=build /app/packages/shared/dist ./packages/shared/dist
COPY --from=build /app/apps/api/package.json ./apps/api/
COPY --from=build /app/apps/api/prisma ./apps/api/prisma
COPY --from=build /app/apps/api/dist ./apps/api/dist

RUN pnpm install --prod --frozen-lockfile
COPY --from=build /app/.prisma-client /app/.prisma-client
RUN client_package="$(find /app/node_modules/.pnpm -path '*/node_modules/@prisma/client/package.json' -print -quit)" \
    && test -n "$client_package" \
    && client_node_modules="$(dirname "$(dirname "$(dirname "$client_package")")")" \
    && mkdir -p "$client_node_modules/.prisma" \
    && rm -rf "$client_node_modules/.prisma/client" \
    && cp -R /app/.prisma-client "$client_node_modules/.prisma/client" \
    && rm -rf /app/.prisma-client
RUN chown -R repairproof:repairproof /app

USER repairproof
EXPOSE 10000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "const http=require('node:http'),port=process.env.PORT||process.env.API_PORT||3001,req=http.get({host:'127.0.0.1',port,path:'/health/live',timeout:4000},res=>process.exit(res.statusCode>=200&&res.statusCode<400?0:1));req.on('error',()=>process.exit(1));req.on('timeout',()=>{req.destroy();process.exit(1)})"
CMD ["node", "apps/api/dist/src/main.js"]
