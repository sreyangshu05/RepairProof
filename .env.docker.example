# Local Docker development defaults only. Never reuse these for deployment.
# scripts/dev-up.ps1 replaces the local AI placeholders with random secrets.
WEB_PORT=5173
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379
VITE_ENABLE_DEMO_FIXTURES=false

# Optional hosted Supabase project for local auth and private evidence storage.
# Placeholder values deliberately leave these integrations unavailable locally.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_STORAGE_BUCKET=repairproof-evidence

# Local-only defaults; setup script replaces these before writing .env.
INVOICE_AI_INTERNAL_TOKEN=generate-on-first-run
INVOICE_AI_SIGNING_SECRET=generate-on-first-run
INVOICE_AI_MAX_DOCUMENT_BYTES=10485760
INVOICE_AI_MAX_PDF_PAGES=5
INVOICE_AI_MAX_CONCURRENT=2

RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
