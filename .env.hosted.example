# Documentation template for Vercel (build-time) and Render (runtime).
# Do not fill secrets in this tracked file. Set them in provider secret stores.

# Vercel build variables (public values compiled into the browser bundle)
VITE_API_URL=https://repairproof-api.onrender.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key-from-supabase
# Set this to the stable Vercel production domain after the first deployment.
VITE_APP_URL=

# Render API runtime variables
NODE_ENV=production
# Render provides PORT=10000 at runtime; do not set API_PORT on Render.
API_CORS_ORIGIN=https://app.example.invalid
PUBLIC_APP_URL=https://app.example.invalid
CERTIFICATE_BASE_URL=https://app.example.invalid
API_TRUST_PROXY_HOPS=1
# Required by RepairProof's API password login and signed access tokens. Set a unique random value in Render.
AUTH_JWT_SECRET=

# First-party product analytics remains disabled until the privacy notice and release review are approved.
PRODUCT_ANALYTICS_ENABLED=false
# If later enabled, set a distinct random secret (32+ characters) in the Render secret store.
ANALYTICS_PSEUDONYM_SECRET=
# Stable runtime key for deterministic flag cohorts and pseudonymous experiment assignments.
FEATURE_FLAG_ASSIGNMENT_SECRET=

# Neon: use the pooled URL for runtime and direct URL for Prisma migrations.
# Replace placeholders; URL-encode username/password characters.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-POOLER-HOST/DB?sslmode=require&connection_limit=5
DIRECT_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-HOST/DB?sslmode=require

# Upstash Redis TLS URL (shared rate-limit state is mandatory in production).
REDIS_URL=rediss://default:PASSWORD@YOUR-UPSTASH-HOST:6379
REDIS_POOL_SIZE=2
REQUIRE_REDIS_RATE_LIMIT=true
RATE_LIMIT_KEY_PREFIX=repairproof:rate-limit

# Supabase Auth and the existing private object-storage adapter.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=public-anon-key-from-supabase
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
EVIDENCE_STORAGE_BUCKET=repairproof-evidence
EVIDENCE_MAX_FILE_BYTES=26214400
EVIDENCE_RETENTION_DAYS=2555
EVIDENCE_RETENTION_WORKER_ENABLED=true
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# Optional integrations
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=
CUSTOMER_AUTHORIZATION_ENABLED=false
