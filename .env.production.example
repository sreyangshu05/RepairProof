# Copy to .env.production and replace every placeholder before deployment.
# Generate DB/Redis passwords as URL-safe hex: openssl rand -hex 32
POSTGRES_DB=repairproof
POSTGRES_USER=repairproof
POSTGRES_PASSWORD=
REDIS_PASSWORD=

WEB_PORT=8080
IMAGE_PREFIX=ghcr.io/your-org/repairproof
IMAGE_TAG=
PUBLIC_APP_URL=
API_TRUST_PROXY_HOPS=1
REDIS_POOL_SIZE=4

# Supabase Storage is used for private evidence only. Authentication is first-party.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
AUTH_JWT_SECRET=replace-with-a-unique-random-secret-at-least-64-hex-characters
EVIDENCE_STORAGE_BUCKET=repairproof-evidence
EVIDENCE_MAX_FILE_BYTES=26214400
EVIDENCE_RETENTION_DAYS=2555
EVIDENCE_RETENTION_WORKER_ENABLED=true
CLAMAV_TIMEOUT_MS=30000

# Optional email, error monitoring and private metrics integrations.
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=

# Required only when starting with --profile ai. Generate independent secrets.
INVOICE_AI_INTERNAL_TOKEN=
INVOICE_AI_SIGNING_SECRET=
INVOICE_AI_MAX_DOCUMENT_BYTES=10485760
INVOICE_AI_MAX_PDF_PAGES=5
INVOICE_AI_MAX_CONCURRENT=2
# Keep public bearer-link access disabled until HTTP privacy/security review and approval.
CUSTOMER_AUTHORIZATION_ENABLED=false

# Runtime feature flag hashing; keep stable while experiments are active.
FEATURE_FLAG_ASSIGNMENT_SECRET=
# Product measurement/experiments remain off until their privacy release review is complete.
PRODUCT_ANALYTICS_ENABLED=false
ANALYTICS_PSEUDONYM_SECRET=
