generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  TECHNICIAN
  SHOP_OWNER
  PLATFORM_ADMIN
}

enum OrganizationRole {
  TECHNICIAN
  SHOP_OWNER
}

enum OrganizationVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum NotificationEmailStatus {
  NOT_QUEUED
  QUEUED
  SENDING
  SENT
  FAILED
}

enum DeviceCategory {
  SMARTPHONE
  LAPTOP
}

enum CaseStatus {
  DRAFT
  SUBMITTED
  UNDER_DIAGNOSIS
  DIAGNOSIS_COMPLETED
  QUOTATION_PENDING
  AWAITING_CUSTOMER_APPROVAL
  APPROVED
  REJECTED
  IN_REPAIR
  AWAITING_VERIFICATION
  COMPLETED
  DISPUTED
  CANCELLED
}

enum CasePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum EvidenceType {
  PHOTO
  VIDEO
  DOCUMENT
}

enum EvidenceCategory {
  INTAKE
  DIAGNOSTIC
  DURING_REPAIR
  POST_REPAIR
}

enum EvidencePurpose {
  PHOTOGRAPH
  INVOICE
  DIAGNOSTIC_REPORT
  COMPONENT_DOCUMENTATION
  TEST_RESULT
  REPAIR_COMPLETION
  OTHER
}

enum EvidenceAssetRole {
  ORIGINAL
  THUMBNAIL
  PROCESSED
}

enum EvidenceMalwareStatus {
  PENDING
  CLEAN
  INFECTED
  NOT_SCANNED
}

enum EvidenceUploadStatus {
  PENDING
  COMPLETED
  REJECTED
  EXPIRED
}

enum QuotationStatus {
  DRAFT
  SENT
  APPROVED
  REJECTED
  SUPERSEDED
}

enum QuotationItemType {
  PART
  LABOR
}

enum QuotationChangeRequestStatus {
  OPEN
  RESOLVED
}

enum PartSource {
  OEM
  AFTERMARKET
  REFURBISHED
  CUSTOMER_PROVIDED
}

enum RepairStepStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum DiagnosticStatus {
  DRAFT
  SUBMITTED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

enum WarrantyStatus {
  ACTIVE
  EXPIRED
  VOID
}

enum WarrantyClaimStatus {
  OPEN
  REVIEWING
  APPROVED
  REJECTED
  RESOLVED
}

enum DisputeStatus {
  OPEN
  REVIEWING
  RESOLVED
  REJECTED
}

model Profile {
  id          String    @id @default(uuid())
  userId      String    @unique // Supabase Auth User ID (auth.users)
  role        UserRole  @default(TECHNICIAN)
  shopId      String?
  displayName String
  phone       String?
  email       String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)

  shop                     Shop?                     @relation(fields: [shopId], references: [id])
  repairCases              RepairCase[]              @relation("AssignedTechnician")
  evidenceCaptured         Evidence[]                @relation("EvidenceAuthor")
  evidenceUploadIntents    EvidenceUploadIntent[]    @relation("EvidenceUploader")
  evidenceDeletionRequests EvidenceDeletionRequest[] @relation("EvidenceDeletionRequester")
  evidenceDeletionReviews  EvidenceDeletionRequest[] @relation("EvidenceDeletionReviewer")
  verifications            Verification[]            @relation("VerifiedBy")
  verificationAttempts     VerificationAttempt[]     @relation("VerificationAttemptAuthor")
  certificates             Certificate[]             @relation("CertificateIssuer")
  memberships              OrganizationMembership[]
  diagnostics              Diagnostic[]              @relation("DiagnosticAuthor")
  componentReplacements    ComponentReplacement[]    @relation("ReplacementAuthor")
  testResults              TestResult[]              @relation("TestAuthor")
  notifications            Notification[]
  auditEvents              AuditEvent[]
  openedDisputes           Dispute[]                 @relation("DisputeOpener")
  platformAdminRecord      PlatformAdmin?            @relation("PlatformAdminSubject")
  platformAdminGrants      PlatformAdmin[]           @relation("PlatformAdminGrantor")
  verifiedOrganizations    Shop[]                    @relation("OrganizationVerifier")
  platformAuditEvents      PlatformAdminAuditEvent[] @relation("PlatformAdminAction")
  repairCaseTransitions    RepairCaseTransition[]    @relation("RepairTransitionActor")

  @@index([shopId])
  @@index([userId])
}

model Shop {
  id        String    @id @default(uuid())
  name      String
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  ownerId   String // Foreign key to auth.users / Profile
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  profiles              Profile[]
  devices               Device[]
  repairCases           RepairCase[]
  evidenceUploadIntents EvidenceUploadIntent[]
  memberships           OrganizationMembership[]
  components            Component[]
  auditEvents           AuditEvent[]
  verificationStatus    OrganizationVerificationStatus @default(PENDING)
  verifiedAt            DateTime?
  verificationNotes     String?
  verifiedById          String?
  verifiedBy            Profile?                       @relation("OrganizationVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([ownerId])
}

model Device {
  id              String         @id @default(uuid())
  shopId          String
  registeredById  String
  category        DeviceCategory
  make            String
  model           String
  serialNumber    String?
  imei            String?
  color           String?
  storageCapacity String?
  intakePhotos    String[]       @default([])
  intakeCondition String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?

  shop        Shop         @relation(fields: [shopId], references: [id])
  repairCases RepairCase[]

  @@index([shopId])
  @@index([serialNumber])
  @@index([imei])
}

model RepairCase {
  id                     String       @id @default(uuid())
  caseNumber             String       @unique
  deviceId               String
  shopId                 String
  technicianId           String?
  status                 CaseStatus   @default(DRAFT)
  priority               CasePriority @default(NORMAL)
  customerName           String
  customerPhone          String
  customerEmail          String?
  problemDescription     String
  authorizationToken     String       @unique
  authorizationExpiresAt DateTime
  estimatedCompletionAt  DateTime?
  closedAt               DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  deletedAt              DateTime?

  device                  Device                   @relation(fields: [deviceId], references: [id])
  shop                    Shop                     @relation(fields: [shopId], references: [id])
  technician              Profile?                 @relation("AssignedTechnician", fields: [technicianId], references: [id])
  evidence                Evidence[]
  evidenceUploadIntents   EvidenceUploadIntent[]
  quotations              Quotation[]
  steps                   RepairStep[]
  verification            Verification?
  verificationAttempts    VerificationAttempt[]
  certificate             Certificate?
  diagnostics             Diagnostic[]
  replacements            ComponentReplacement[]
  testResults             TestResult[]
  warranty                Warranty?
  disputes                Dispute[]
  lifecycleTransitions    RepairCaseTransition[]
  quotationChangeRequests QuotationChangeRequest[]

  @@index([shopId])
  @@index([deviceId])
  @@index([technicianId])
  @@index([status])
  @@index([authorizationToken])
}

model Evidence {
  id                        String                @id @default(uuid())
  caseId                    String
  capturedById              String
  type                      EvidenceType          @default(PHOTO)
  category                  EvidenceCategory
  purpose                   EvidencePurpose       @default(OTHER)
  assetRole                 EvidenceAssetRole     @default(ORIGINAL)
  fileUrl                   String?
  thumbnailUrl              String?
  legacySourceUrl           String?
  legacyThumbnailUrl        String?
  fileName                  String
  fileSize                  Int
  mimeType                  String
  verifiedMimeType          String?
  storagePath               String?               @unique
  contentSha256             String?               @db.Char(64)
  malwareStatus             EvidenceMalwareStatus @default(NOT_SCANNED)
  malwareScannedAt          DateTime?
  malwareSignature          String?
  retentionUntil            DateTime?
  derivedFromId             String?
  legacyUnverified          Boolean               @default(true)
  truthfulContentAttestedAt DateTime?
  integrityStatement        String?
  description               String?
  capturedAt                DateTime              @default(now())
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
  deletedAt                 DateTime?

  repairCase         RepairCase                @relation(fields: [caseId], references: [id], onDelete: Cascade)
  capturedBy         Profile                   @relation("EvidenceAuthor", fields: [capturedById], references: [id])
  annotations        EvidenceAnnotation[]
  quotationEvidence  QuotationEvidence[]
  replacementRecords ComponentReplacement[]    @relation("ReplacementEvidence")
  testResultRecords  TestResult[]              @relation("TestResultEvidence")
  uploadIntent       EvidenceUploadIntent?     @relation("EvidenceUploadResult")
  deletionRequests   EvidenceDeletionRequest[]
  derivedFrom        Evidence?                 @relation("EvidenceDerivatives", fields: [derivedFromId], references: [id], onDelete: Restrict)
  derivatives        Evidence[]                @relation("EvidenceDerivatives")

  @@index([caseId])
  @@index([category])
  @@index([purpose, createdAt])
  @@index([malwareStatus, retentionUntil])
  @@index([derivedFromId])
}

model EvidenceUploadIntent {
  id             String                @id @default(uuid())
  caseId         String
  shopId         String
  uploadedById   String
  objectPath     String                @unique
  originalName   String
  declaredMime   String
  expectedBytes  Int
  category       EvidenceCategory
  purpose        EvidencePurpose
  description    String?
  idempotencyKey String
  requestHash    String
  status         EvidenceUploadStatus  @default(PENDING)
  scanStatus     EvidenceMalwareStatus @default(PENDING)
  scanSignature  String?
  expiresAt      DateTime
  completedAt    DateTime?
  evidenceId     String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  repairCase     RepairCase            @relation(fields: [caseId], references: [id], onDelete: Restrict)
  shop           Shop                  @relation(fields: [shopId], references: [id], onDelete: Restrict)
  uploadedBy     Profile               @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  evidence       Evidence?             @relation("EvidenceUploadResult", fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([caseId, idempotencyKey])
  @@index([shopId, caseId, status, createdAt])
  @@index([status, expiresAt])
}

model EvidenceDeletionRequest {
  id            String    @id @default(uuid())
  evidenceId    String
  requestedById String
  reviewedById  String?
  reason        String
  status        String    @default("PENDING")
  requestedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  completedAt   DateTime?
  evidence      Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  requestedBy   Profile   @relation("EvidenceDeletionRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  reviewedBy    Profile?  @relation("EvidenceDeletionReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)

  @@index([evidenceId, status, requestedAt])
}

model EvidenceAnnotation {
  id         String   @id @default(uuid())
  evidenceId String
  x          Float // Percentage (0.0 to 100.0)
  y          Float // Percentage (0.0 to 100.0)
  note       String
  authorName String?
  createdAt  DateTime @default(now())

  evidence Evidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  @@index([evidenceId])
}

model Quotation {
  id                       String          @id @default(uuid())
  caseId                   String
  version                  Int             @default(1)
  status                   QuotationStatus @default(DRAFT)
  laborCost                Decimal         @default(0.0) @db.Decimal(10, 2)
  partsCost                Decimal         @default(0.0) @db.Decimal(10, 2)
  taxAmount                Decimal         @default(0.0) @db.Decimal(10, 2)
  totalCost                Decimal         @default(0.0) @db.Decimal(10, 2)
  diagnosedIssue           String          @db.Text
  proposedRepair           String          @db.Text
  additionalCharges        Decimal         @default(0.0) @db.Decimal(10, 2)
  taxRate                  Decimal         @default(0.0) @db.Decimal(5, 4)
  estimatedCompletionHours Int
  warrantyTerms            String          @db.Text
  currency                 String          @default("USD")
  validUntil               DateTime
  customerResponseNote     String?
  respondedAt              DateTime?
  createdAt                DateTime        @default(now())
  updatedAt                DateTime        @updatedAt
  deletedAt                DateTime?

  repairCase                   RepairCase               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  items                        QuotationItem[]
  approval                     Approval?
  evidence                     QuotationEvidence[]
  changeRequests               QuotationChangeRequest[] @relation("RequestedQuotation")
  replacementForChangeRequests QuotationChangeRequest[] @relation("ReplacementQuotation")

  @@unique([caseId, version])
  @@index([caseId])
}

model QuotationEvidence {
  quotationId String
  evidenceId  String
  attachedAt  DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  evidence    Evidence  @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@id([quotationId, evidenceId])
  @@index([evidenceId])
}

model QuotationChangeRequest {
  id                     String                       @id @default(uuid())
  caseId                 String
  quotationId            String
  replacementQuotationId String?
  customerSignatureName  String
  requestText            String                       @db.Text
  status                 QuotationChangeRequestStatus @default(OPEN)
  idempotencyKey         String
  requestHash            String
  createdAt              DateTime                     @default(now())
  resolvedAt             DateTime?
  repairCase             RepairCase                   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  quotation              Quotation                    @relation("RequestedQuotation", fields: [quotationId], references: [id], onDelete: Restrict)
  replacementQuotation   Quotation?                   @relation("ReplacementQuotation", fields: [replacementQuotationId], references: [id], onDelete: Restrict)

  @@unique([caseId, idempotencyKey])
  @@index([caseId, status, createdAt])
  @@index([quotationId, createdAt])
}

model QuotationItem {
  id          String            @id @default(uuid())
  quotationId String
  type        QuotationItemType
  description String
  partName    String?
  partSource  PartSource?
  quantity    Int               @default(1)
  unitPrice   Decimal           @db.Decimal(10, 2)
  totalPrice  Decimal           @db.Decimal(10, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model RepairStep {
  id             String           @id @default(uuid())
  caseId         String
  stepNumber     Int
  title          String
  description    String
  status         RepairStepStatus @default(PENDING)
  photos         String[]         @default([])
  partsUsed      Json             @default("[]") // Array of { name, partNumber, source, cost }
  performedById  String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  idempotencyKey String?
  requestHash    String?

  repairCase RepairCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, stepNumber])
  @@unique([caseId, idempotencyKey])
  @@index([caseId])
}

model Verification {
  id           String   @id @default(uuid())
  caseId       String   @unique
  verifiedById String
  passed       Boolean
  notes        String?
  checklist    Json     @default("[]") // Array of { id, label, category, passed, notes }
  verifiedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  repairCase RepairCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  verifiedBy Profile    @relation("VerifiedBy", fields: [verifiedById], references: [id])

  @@index([caseId])
}

model VerificationAttempt {
  id             String     @id @default(uuid())
  caseId         String
  verifiedById   String
  passed         Boolean
  notes          String?
  checklist      Json       @default("[]")
  idempotencyKey String     @unique
  requestHash    String
  verifiedAt     DateTime   @default(now())
  repairCase     RepairCase @relation(fields: [caseId], references: [id], onDelete: Restrict)
  verifiedBy     Profile    @relation("VerificationAttemptAuthor", fields: [verifiedById], references: [id], onDelete: Restrict)

  @@index([caseId, verifiedAt])
}

model Certificate {
  id                   String   @id @default(uuid())
  caseId               String   @unique
  certificateNumber    String   @unique
  qrCodeUrl            String
  verificationUrl      String
  pdfUrl               String?
  warrantyPeriodMonths Int      @default(3)
  warrantyTerms        String?
  issuedAt             DateTime @default(now())
  issuedById           String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  repairCase RepairCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  issuedBy   Profile    @relation("CertificateIssuer", fields: [issuedById], references: [id])
  warranty   Warranty?

  @@index([certificateNumber])
}

model OrganizationMembership {
  id        String           @id @default(uuid())
  shopId    String
  profileId String
  role      OrganizationRole @default(TECHNICIAN)
  joinedAt  DateTime         @default(now())
  revokedAt DateTime?
  shop      Shop             @relation(fields: [shopId], references: [id], onDelete: Restrict)
  profile   Profile          @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([shopId, profileId])
  @@index([profileId, revokedAt])
}

model Diagnostic {
  id          String           @id @default(uuid())
  caseId      String
  authorId    String
  status      DiagnosticStatus @default(DRAFT)
  findings    Json
  severity    String?
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  repairCase  RepairCase       @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author      Profile          @relation("DiagnosticAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
}

model Approval {
  id                     String         @id @default(uuid())
  quotationId            String         @unique
  status                 ApprovalStatus @default(PENDING)
  customerSignatureName  String?
  notes                  String?
  respondedAt            DateTime?
  decisionIdempotencyKey String?        @unique
  decisionRequestHash    String?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  quotation              Quotation      @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model RepairCaseTransition {
  id                String      @id @default(uuid())
  caseId            String
  fromState         CaseStatus?
  toState           CaseStatus
  actorProfileId    String?
  actorRole         String
  reason            String?
  supportingRecords Json        @default("[]")
  idempotencyKey    String?
  requestHash       String?
  createdAt         DateTime    @default(now())
  repairCase        RepairCase  @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor             Profile?    @relation("RepairTransitionActor", fields: [actorProfileId], references: [id], onDelete: SetNull)

  @@unique([caseId, idempotencyKey])
  @@index([caseId, createdAt])
  @@index([toState, createdAt])
}

model Component {
  id               String                 @id @default(uuid())
  shopId           String
  sku              String?
  name             String
  manufacturer     String?
  source           PartSource             @default(AFTERMARKET)
  quantityOnHand   Int                    @default(0)
  reorderThreshold Int                    @default(0)
  unitCost         Decimal                @default(0) @db.Decimal(10, 2)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  deletedAt        DateTime?
  shop             Shop                   @relation(fields: [shopId], references: [id], onDelete: Restrict)
  replacements     ComponentReplacement[]

  @@unique([shopId, sku])
  @@index([shopId, deletedAt])
}

model ComponentReplacement {
  id           String     @id @default(uuid())
  caseId       String
  componentId  String?
  authorId     String
  nameSnapshot String
  quantity     Int
  unitCost     Decimal    @db.Decimal(10, 2)
  source       PartSource
  evidenceId   String?
  evidenceIds  String[]   @default([])
  replacedAt   DateTime   @default(now())
  repairCase   RepairCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  component    Component? @relation(fields: [componentId], references: [id], onDelete: SetNull)
  author       Profile    @relation("ReplacementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  evidence     Evidence?  @relation("ReplacementEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([caseId, replacedAt])
  @@index([evidenceId])
  @@index([evidenceIds], type: Gin)
}

model TestResult {
  id          String     @id @default(uuid())
  caseId      String
  authorId    String
  name        String
  passed      Boolean
  details     Json?
  notes       String?
  testedAt    DateTime   @default(now())
  evidenceId  String?
  evidenceIds String[]   @default([])
  repairCase  RepairCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author      Profile    @relation("TestAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  evidence    Evidence?  @relation("TestResultEvidence", fields: [evidenceId], references: [id], onDelete: SetNull)

  @@index([caseId, testedAt])
  @@index([evidenceId])
  @@index([evidenceIds], type: Gin)
}

model Warranty {
  id            String          @id @default(uuid())
  caseId        String          @unique
  certificateId String?         @unique
  status        WarrantyStatus  @default(ACTIVE)
  startsAt      DateTime
  endsAt        DateTime
  terms         String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  repairCase    RepairCase      @relation(fields: [caseId], references: [id], onDelete: Restrict)
  certificate   Certificate?    @relation(fields: [certificateId], references: [id], onDelete: SetNull)
  claims        WarrantyClaim[]

  @@index([status, endsAt])
}

model WarrantyClaim {
  id          String              @id @default(uuid())
  warrantyId  String
  status      WarrantyClaimStatus @default(OPEN)
  description String
  resolution  String?
  openedAt    DateTime            @default(now())
  closedAt    DateTime?
  warranty    Warranty            @relation(fields: [warrantyId], references: [id], onDelete: Restrict)

  @@index([warrantyId, status])
}

model Notification {
  id                 String                  @id @default(uuid())
  profileId          String?
  recipientEmail     String?
  type               String
  title              String
  body               String
  payload            Json                    @default("{}")
  readAt             DateTime?
  createdAt          DateTime                @default(now())
  emailStatus        NotificationEmailStatus @default(NOT_QUEUED)
  emailAttempts      Int                     @default(0)
  emailNextAttemptAt DateTime?
  emailLockedUntil   DateTime?
  emailSentAt        DateTime?
  emailLastError     String?
  profile            Profile?                @relation(fields: [profileId], references: [id], onDelete: SetNull)

  @@index([profileId, readAt, createdAt])
  @@index([emailStatus, emailNextAttemptAt, createdAt])
  @@index([emailStatus, emailLockedUntil, createdAt])
}

model PlatformAdmin {
  id                 String    @id @default(uuid())
  profileId          String    @unique
  previousRole       UserRole
  active             Boolean   @default(true)
  reason             String
  grantedAt          DateTime  @default(now())
  revokedAt          DateTime?
  grantedByProfileId String?
  profile            Profile   @relation("PlatformAdminSubject", fields: [profileId], references: [id], onDelete: Restrict)
  grantedBy          Profile?  @relation("PlatformAdminGrantor", fields: [grantedByProfileId], references: [id], onDelete: SetNull)

  @@index([active, grantedAt])
}

model PlatformAdminAuditEvent {
  id             String   @id @default(uuid())
  actorProfileId String
  action         String
  targetType     String
  targetId       String
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  actor          Profile  @relation("PlatformAdminAction", fields: [actorProfileId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([targetType, targetId, createdAt])
}

model AuditEvent {
  id         String   @id @default(uuid())
  shopId     String
  actorId    String?
  action     String
  entityType String
  entityId   String
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  shop       Shop     @relation(fields: [shopId], references: [id], onDelete: Restrict)
  actor      Profile? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([shopId, createdAt])
  @@index([entityType, entityId, createdAt])
}

model Dispute {
  id             String        @id @default(uuid())
  caseId         String
  openedById     String?
  status         DisputeStatus @default(OPEN)
  reason         String
  description    String
  resolution     String?
  openedAt       DateTime      @default(now())
  resolvedAt     DateTime?
  idempotencyKey String?
  requestHash    String?
  repairCase     RepairCase    @relation(fields: [caseId], references: [id], onDelete: Restrict)
  openedBy       Profile?      @relation("DisputeOpener", fields: [openedById], references: [id], onDelete: SetNull)

  @@unique([caseId, idempotencyKey])
  @@index([status, openedAt])
  @@index([caseId, openedAt])
}
