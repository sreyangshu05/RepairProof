# ============================================
# RepairProof â€” Environment Configuration
# ============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Database (Supabase PostgreSQL) ---
# Pooled connection for runtime queries (port 6543)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection for Prisma migrations (port 5432)
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# --- API Server ---
API_PORT=3001
API_CORS_ORIGIN=http://localhost:5173
# Set to the exact trusted proxy hop count in production so per-IP rate limits use the client address.
API_TRUST_PROXY_HOPS=0
AUTH_JWT_SECRET=replace-with-at-least-64-random-hex-characters

# --- Shared rate limiting (required in production / multi-replica deployments) ---
# For local non-Docker API: redis://localhost:6379
REDIS_URL=redis://localhost:6379
REDIS_POOL_SIZE=4
RATE_LIMIT_KEY_PREFIX=repairproof:rate-limit

# --- Notification email delivery (Resend; optional locally) ---
RESEND_API_KEY=
EMAIL_FROM=

# --- Optional error monitoring (Sentry; structured logs remain available without it) ---
SENTRY_DSN=

# --- API operations ---
# Keep metrics private behind an internal scraper/network policy and a random bearer token.
METRICS_ENABLED=false
METRICS_BEARER_TOKEN=

# --- Explicit platform administrator provisioning ---
PLATFORM_ADMIN_USER_ID=
PLATFORM_ADMIN_ACTION=grant
PLATFORM_ADMIN_REASON=

# --- Frontend ---
VITE_API_URL=/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_APP_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# --- Private evidence storage ---
SUPABASE_SERVICE_ROLE_KEY=
EVIDENCE_STORAGE_BUCKET=repairproof-evidence
EVIDENCE_MAX_FILE_BYTES=26214400
EVIDENCE_RETENTION_DAYS=2555
EVIDENCE_RETENTION_WORKER_ENABLED=true
# Early deletion is blocked while retention is active; set true only for an approved policy override.
EVIDENCE_RETENTION_ALLOW_EARLY_DELETION=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_MS=30000

# --- Certificate ---
CERTIFICATE_BASE_URL=http://localhost:5173

# --- Optional first-party product analytics (disabled by default) ---
PRODUCT_ANALYTICS_ENABLED=false
# Use an environment-specific random secret of at least 32 characters. Never commit a real value.
ANALYTICS_PSEUDONYM_SECRET=

# --- Runtime feature flags and consented experiments ---
# Stable, environment-specific HMAC key; keep unchanged while experiments are active.
FEATURE_FLAG_ASSIGNMENT_SECRET=

# --- Optional local-only diagnostic explanation (no hosted LLM/API fees) ---
# Leave disabled by default. For docker compose, enable the local-llm profile and pull a model.
DIAGNOSTIC_LLM_ENABLED=false
DIAGNOSTIC_LLM_BASE_URL=http://127.0.0.1:11434
DIAGNOSTIC_LLM_MODEL=

# --- Optional isolated integration-test database (never production) ---
# TEST_DATABASE_URL=postgresql://...
# --- Optional private invoice OCR service (Docker Compose profile: ai) ---
# Generate independent random secrets of at least 32 characters before use.
INVOICE_AI_INTERNAL_TOKEN=
INVOICE_AI_SIGNING_SECRET=
INVOICE_AI_MAX_DOCUMENT_BYTES=10485760
INVOICE_AI_MAX_PDF_PAGES=5
INVOICE_AI_MAX_CONCURRENT=2
# Customer bearer-link endpoints are unavailable unless explicitly enabled after review.
CUSTOMER_AUTHORIZATION_ENABLED=false
